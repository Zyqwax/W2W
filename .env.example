# TMDB API configuration
NEXT_PUBLIC_TMDB_API_KEY=your_tmdb_api_key

# Existing local PostgreSQL server (adjust role/password/port to your server)
DATABASE_URL=postgres://YOUR_POSTGRES_USER:YOUR_POSTGRES_PASSWORD@localhost:5432/w2w

# Better Auth (generate a random secret, e.g. `openssl rand -base64 32`)
BETTER_AUTH_SECRET=replace_with_a_random_secret_at_least_32_characters
BETTER_AUTH_URL=http://localhost:3000

# Google OAuth Web client credentials
GOOGLE_CLIENT_ID=your_google_oauth_client_id
GOOGLE_CLIENT_SECRET=your_google_oauth_client_secret
