# TMDB API configuration
NEXT_PUBLIC_TMDB_API_KEY=your_tmdb_api_key
# Optional server-only key for series. Falls back to NEXT_PUBLIC_TMDB_API_KEY.
TMDB_API_KEY=

# Docker Compose PostgreSQL defaults. The app container uses the `db` hostname;
# this URL is for commands run directly on the host machine.
POSTGRES_USER=w2w
POSTGRES_PASSWORD=w2w_dev_password
POSTGRES_DB=w2w
POSTGRES_PORT=5433
APP_PORT=3000
DATABASE_URL=postgresql://w2w:w2w_dev_password@localhost:5433/w2w

# Better Auth (generate a random secret, e.g. `openssl rand -base64 32`)
BETTER_AUTH_SECRET=replace_with_a_random_secret_at_least_32_characters
BETTER_AUTH_URL=http://localhost:3000

# Google OAuth Web client credentials
GOOGLE_CLIENT_ID=your_google_oauth_client_id
GOOGLE_CLIENT_SECRET=your_google_oauth_client_secret
